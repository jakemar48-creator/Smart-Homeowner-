# Public project URL is safe for browser builds; the service key must stay server-side.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Use true only for local UI demo data. Set false in Vercel production.
SMART_HOMEOWNER_DEMO_MODE=true

# Required server-only GHL inbound webhook for the generic /roofing campaign.
# Set the supplied URL as a secret in the deployment environment.
# Use a disposable local endpoint for development/testing.
SMART_HOMEOWNER_ROOFING_WEBHOOK_URL=
